# --- API ---
PORT=3001
DATABASE_URL="postgresql://volleyvision:CAMBIAMI@127.0.0.1:5432/volleyvision"
JWT_SECRET="cambiami-in-produzione"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Storage: "local" in sviluppo, "gcs"/"s3" in seguito
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage-dev

# Limite di caricamento: stima indicativa finche non sono noti
# i requisiti del fornitore dell'analisi video
MAX_VIDEO_BYTES=5368709120
UPLOAD_CHUNK_BYTES=8388608
UPLOAD_SESSION_TTL_DAYS=7

# Email: "console" scrive a terminale invece di inviare
MAIL_DRIVER=console

# --- WEB ---
VITE_API_URL=http://localhost:3001
