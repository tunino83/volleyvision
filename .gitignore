*.db
*.db-journal
storage-dev/
.DS_Store

# Emessi per errore da un vecchio script di build: il sorgente e .tsx
apps/web/src/**/*.js

# Copie di sicurezza del database e dump di travaso: contengono dati reali
# (email, password hash), non vanno mai versionati.
*.db.prima-*
apps/api/prisma/travaso.json

# Seed SQL generato: 33 MB, si riproduce con
#   npx tsx prisma/genera-seed-sql.ts > prisma/seed-demo.sql
# Versionare un artefatto rigenerabile appesantisce il repository per sempre.
apps/api/prisma/seed-demo.sql

# Comandi personali con credenziali dentro: restano sulla macchina di chi li
# scrive. Un file con la password del database in chiaro non va versionato.
seedDbRender.sh
*.local.sh

# Android: il progetto va versionato, cio che Gradle genera no.
# local.properties contiene il percorso dell SDK di CHI costruisce: su un
# altro computer sarebbe sbagliato, e non e un dato del progetto.
apps/web/android/local.properties
apps/web/android/.gradle/
apps/web/android/app/build/
apps/web/android/build/
apps/web/android/capacitor-cordova-android-plugins/
