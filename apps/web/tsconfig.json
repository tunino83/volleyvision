{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "resolveJsonModule": true,
    // `import.meta.env`: senza questi tipi TypeScript non sa che Vite lo
    // definisce, e non si puo distinguere sviluppo da esercizio nel codice.
    "types": ["vite/client"]
  },
  "include": ["src"]
}
